{
  "listen": { "host": "127.0.0.1", "port": 8878 },
  "upstream": {
    "name": "mock-persona",
    "base_url": "http://127.0.0.1:8899/v1",
    "api_key": "mock",
    "model": "mock-persona",
    "timeout_s": 60,
    "temperature": null
  },
  "tool_mode": "text-protocol",
  "always_expose_tools": true,
  "max_tool_rounds": 4,
  "upstream_history": "last_user_only",
  "include_client_system": false,
  "vision": {
    "base_url": "http://127.0.0.1:8894/v1",
    "api_key": "mock-key",
    "model": "mock-vision",
    "detail": "auto",
    "max_pixels": 1300,
    "inherit_upstream_key": false
  },
  "jobs": {
    "enabled": false,
    "workers": 1,
    "notify": false,
    "db": ""
  },
  "memory": {
    "auto_index": false
  },
  "outbox": {
    "dir": "",
    "ttl": 600,
    "max_items": 50
  },
  "devices": {
    "mode": "off"
  },
  "plans": {
    "db": ""
  },
  "audit": {
    "enabled": false,
    "db": "",
    "max_rows": 2000
  },
  "policy": {
    "mode": "audit",
    "deny": [],
    "allow": [],
    "deny_paths": [],
    "max_calls_per_minute": 0,
    "exempt": ["audit_*", "policy_*", "jobs_*", "plan_*"]
  },
  "log": {
    "format": "text",
    "max_mb": 8
  },
  "profiles": {},
  "proxy": {
    "enabled": false,
    "listen": { "host": "127.0.0.1", "port": 8892 },
    "upstream_base": "http://127.0.0.1:8891/v1",
    "upstream_api_key": "mock",
    "tool_models": ["mock-native"],
    "max_tool_rounds": 12,
    "max_seconds": 120,
    "heartbeat_seconds": 5,
    "vision_check_seconds": 600,
    "step_report": "brief",
    "progress_stream": true,
    "progress_max": 3,
    "inject_tool_hint": true
  },
  "servers": [
    {
      "name": "fs",
      "enabled": true,
